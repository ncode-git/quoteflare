{
  "name": "quoteflare",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "deploy:production": "WRANGLER_CONFIG=wrangler.production.toml bun run build && wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "bun run cf-typegen && tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.production.toml",
    "db:export": "mkdir -p backups && wrangler d1 export DB --remote -c wrangler.production.toml --output=backups/quoteflare-$(date -u +%Y%m%dT%H%M%SZ).sql",
    "db:export:local": "mkdir -p backups && wrangler d1 export DB --local --output=backups/local-$(date -u +%Y%m%dT%H%M%SZ).sql",
    "db:seed": "bun scripts/import-services.ts src/db/seed-services.json",
    "services:import": "bun scripts/import-services.ts",
    "services:import:remote": "npx tsx scripts/import-services.ts --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@base-ui/utils": "^0.5.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.4",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "currency-codes": "^2.2.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "nuqs": "^2.10.2",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@eslint/js": "^10.0.1",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "miniflare": "^4.20260730.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-tailwindcss-canonical-classes": "^0.1.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "^0.35.5",
    "postcss": "^8.5.23",
    "postcss-selector-parser": "^6.1.5"
  }
}
